# LiveKit Cloud project. The same credentials authenticate LiveKit Inference
# (claim extraction, photo verification, and sketches).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me

# Tavus avatar. Leave TAVUS_API_KEY empty for voice-only mode.
TAVUS_API_KEY=replace-me
# Optional: pick a stock or custom face and PAL. Defaults to the Tavus stock pairing.
# TAVUS_FACE_ID=
# TAVUS_PAL_ID=

# OpenAI voice pipeline: speech-to-text, LLM, and text-to-speech.
OPENAI_API_KEY=
