# LiveKit Cloud project. The same credentials authenticate LiveKit Inference
# (claim extraction, photo verification, sketches, and the voice fallback).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me

# Tavus avatar. Leave TAVUS_API_KEY empty for voice-only mode.
TAVUS_API_KEY=replace-me
# Optional: pick a stock or custom face and PAL. Defaults to the Tavus stock pairing.
# TAVUS_FACE_ID=
# TAVUS_PAL_ID=

# OpenAI GPT-Live voice model. GPT-Live is not served through LiveKit Inference,
# so it needs an OpenAI key with GPT-Live access. Without it the agent falls back
# to a speech-to-text, LLM, text-to-speech pipeline on LiveKit Inference.
OPENAI_API_KEY=

# Optional model overrides. Defaults are shown.
# FNOL_VOICE_MODEL=gpt-live-1
# FNOL_VOICE=marin
# FNOL_BACKEND_MODEL=gpt-5.6-luna
# FNOL_CLAIM_MODEL=openai/gpt-5-mini
# FNOL_VISION_MODEL=openai/gpt-5-mini
# FNOL_SKETCH_MODEL=openai/gpt-5
# FNOL_FALLBACK_LLM=openai/gpt-4.1-mini
# FNOL_STT_MODEL=deepgram/nova-3
# FNOL_TTS_MODEL=cartesia/sonic-3
# FNOL_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc  # Cartesia Jacqueline (female)

# Explicit dispatch name shared by the agent worker and token server.
# FNOL_AGENT_NAME=insurance-claim-agent
# Avatar label shown in the UI.
# FNOL_AVATAR_MODEL_LABEL=Tavus Phoenix 4.5

# Web server for the claimant UI and token minting.
# FNOL_WEB_HOST=127.0.0.1
# FNOL_WEB_PORT=4177
